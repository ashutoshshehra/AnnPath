<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>AnnPath — Global Food Surplus Redistribution Platform</display-name>
    <description>
        Enterprise web platform connecting food donors, verified NGOs, and volunteer dispatch networks.
        Moving surplus food safely, rapidly, and transparently before it expires.
    </description>

    <!-- ==================================================================== -->
    <!-- APPLICATION LIFECYCLE LISTENER                                       -->
    <!-- ==================================================================== -->
    <listener>
        <listener-class>org.annpath.listener.AppContextListener</listener-class>
    </listener>

    <!-- ==================================================================== -->
    <!-- FILTER CHAIN ORDER DEFINITION                                        -->
    <!-- 1. UTF-8 Character Encoding Filter                                   -->
    <!-- 2. Security Headers (CSP, X-Frame-Options, X-Content-Type)           -->
    <!-- 3. Localization Filter (Locale detection, ResourceBundle resolution) -->
    <!-- 4. Rate Limiting Filter (Sliding window IP-based throttling)         -->
    <!-- 5. Authentication Filter (Role-based access boundaries)               -->
    <!-- 6. CSRF Protection Filter (Token validation on state-changing verbs) -->
    <!-- ==================================================================== -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>org.annpath.filter.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>SecurityHeadersFilter</filter-name>
        <filter-class>org.annpath.filter.SecurityHeadersFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SecurityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>LocalizationFilter</filter-name>
        <filter-class>org.annpath.filter.LocalizationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>LocalizationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>RateLimitingFilter</filter-name>
        <filter-class>org.annpath.filter.RateLimitingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RateLimitingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>org.annpath.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/donor/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/ngo/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/volunteer/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>CsrfProtectionFilter</filter-name>
        <filter-class>org.annpath.filter.CsrfProtectionFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfProtectionFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ==================================================================== -->
    <!-- SERVLET REGISTRATIONS & MAPPINGS                                     -->
    <!-- ==================================================================== -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>org.annpath.controller.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>org.annpath.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/auth/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OtpServlet</servlet-name>
        <servlet-class>org.annpath.controller.OtpServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OtpServlet</servlet-name>
        <url-pattern>/otp/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DonorServlet</servlet-name>
        <servlet-class>org.annpath.controller.DonorServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>10485760</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>DonorServlet</servlet-name>
        <url-pattern>/donor/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>NgoServlet</servlet-name>
        <servlet-class>org.annpath.controller.NgoServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>10485760</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>NgoServlet</servlet-name>
        <url-pattern>/ngo/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VolunteerServlet</servlet-name>
        <servlet-class>org.annpath.controller.VolunteerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VolunteerServlet</servlet-name>
        <url-pattern>/volunteer/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReceiptServlet</servlet-name>
        <servlet-class>org.annpath.controller.ReceiptServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReceiptServlet</servlet-name>
        <url-pattern>/receipt/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>NotificationServlet</servlet-name>
        <servlet-class>org.annpath.controller.NotificationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NotificationServlet</servlet-name>
        <url-pattern>/notifications/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LocaleServlet</servlet-name>
        <servlet-class>org.annpath.controller.LocaleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LocaleServlet</servlet-name>
        <url-pattern>/locale</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiServlet</servlet-name>
        <servlet-class>org.annpath.controller.ApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiServlet</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ImpactServlet</servlet-name>
        <servlet-class>org.annpath.controller.ImpactServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ImpactServlet</servlet-name>
        <url-pattern>/impact</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PassportServlet</servlet-name>
        <servlet-class>org.annpath.controller.PassportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PassportServlet</servlet-name>
        <url-pattern>/rescue/passport</url-pattern>
        <url-pattern>/passport</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ComplaintServlet</servlet-name>
        <servlet-class>org.annpath.controller.ComplaintServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ComplaintServlet</servlet-name>
        <url-pattern>/complaint</url-pattern>
        <url-pattern>/complaint/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FeedbackServlet</servlet-name>
        <servlet-class>org.annpath.controller.FeedbackServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FeedbackServlet</servlet-name>
        <url-pattern>/feedback</url-pattern>
        <url-pattern>/feedback/*</url-pattern>
    </servlet-mapping>

    <!-- ==================================================================== -->
    <!-- SESSION CONFIGURATION                                                -->
    <!-- ==================================================================== -->
    <session-config>
        <session-timeout>60</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- In production behind HTTPS reverse proxy, enable <secure>true</secure> -->
            <!-- <secure>true</secure> -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- ==================================================================== -->
    <!-- WELCOME FILE LIST                                                    -->
    <!-- ==================================================================== -->
    <welcome-file-list>
        <welcome-file>home</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ==================================================================== -->
    <!-- ERROR PAGE MAPPINGS                                                  -->
    <!-- ==================================================================== -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error/403.jsp</location>
    </error-page>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

</web-app>
